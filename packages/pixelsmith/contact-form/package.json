{
  "name": "@pixelsmith/contact-form",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "import": "./src/index.tsx"
    },
    "./server": {
      "types": "./src/server-entry.ts",
      "import": "./src/server-entry.ts"
    },
    "./submission-log": {
      "types": "./src/submission-log.ts",
      "import": "./src/submission-log.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": ["src", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "postgres": "^3.4.9"
  },
  "peerDependencies": {
    "react": ">=19 <20",
    "react-dom": ">=19 <20"
  }
}
